# Local output location; no API keys are required for RGB-only operation.
# Optional overrides. Default: /workspace if it exists and is writable, else ~/.spatialmemory.
# SPATIALMEMORY_WORKSPACE=/workspace
# SPATIALMEMORY_MODELS=/workspace/spatialmemory-models
# SPATIALMEMORY_THIRDPARTY=/workspace/spatialmemory-thirdparty
# SPATIALMEMORY_RUNS=/workspace/spatialmemory-runs
